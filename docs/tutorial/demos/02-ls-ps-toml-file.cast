{"version": 2, "width": 110, "height": 34, "timestamp": 1795103054, "idle_time_limit": 3.0, "env": {}, "title": "fatelf: ls + ps (file)"}
[0.01559, "o", "\r\n\u001b[38;2;0;207;232m# Two real dynamically linked ELF programs, one executable entrypoint.\u001b[0m\r\n"]
[0.766981, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf --version\r\n"]
[0.76821, "o", "fatelf 0.2.0-beta.1\r\n"]
[1.519712, "o", "\u001b[38;2;255;176;0m$\u001b[0m file /usr/bin/ls /usr/bin/ps\r\n"]
[1.521821, "o", "/usr/bin/ls: ELF 64-bit LSB pie executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, BuildID[sha1]=81b5d6f5a31252fcf5d81891d1cb248635833569, for GNU/Linux 3.2.0, stripped\r\n"]
[1.522007, "o", "/usr/bin/ps: ELF 64-bit LSB pie executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, BuildID[sha1]=fd838af973db29db9e8ca4bed0cda9168a654af6, for GNU/Linux 3.2.0, stripped\r\n"]
[2.286935, "o", "\r\n\u001b[38;2;0;207;232m# Front manifest, plain ls body, and compressed/encrypted ps from TOML.\u001b[0m\r\n"]
[3.038569, "o", "\u001b[38;2;255;176;0m$\u001b[0m cat bundle.toml\r\n"]
[3.039856, "o", "version = 2\r\noutput = \"combined\"\r\n\r\n[[keys]]\r\nname = \"ps\"\r\nkey_file = \"ps.key\"\r\nenv = \"PS_KEY_FILE\"\r\n\r\n[[payloads]]\r\nname = \"ls\"\r\npath = \"/usr/bin/ls\"\r\nshuffle = false\r\ncompression = \"none\"\r\n\r\n[[payloads]]\r\nname = \"ps\"\r\npath = \"/usr/bin/ps\"\r\nshuffle = true\r\ncompression = \"lz4\"\r\nencryption = \"ps\"\r\n\r\n[selection]\r\nenv = \"FATELF_APP\"\r\ndefault = \"ls\"\r\n\r\n[storage]\r\nlayout = \"overlay\"\r\nmanifest_position = \"front\"\r\norder = \"shuffled\"\r\ndedup = true\r\nseed = 42\r\n\r\n[execution]\r\nbackend = \"file\"\r\n"]
[3.791118, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf plan --config ./bundle.toml\r\n"]
[3.794485, "o", "{\r\n  \"footer_bytes\": 64,\r\n  \"launcher_bytes\": 529064,\r\n  \"logical_bytes\": 282368,\r\n  \"manifest_bytes\": 10371,\r\n  \"manifest_position\": \"front\",\r\n  \"output_bytes\": 770398,\r\n  \"payloads\": [\r\n    {\r\n      \"encrypted_objects\": 0,\r\n      \"header_length\": 64,\r\n      \"length\": 153448,\r\n      \"name\": \"ls\",\r\n      \"object_references\": 39\r\n    },\r\n    {\r\n      \"encrypted_objects\": 33,\r\n      \"header_length\": 64,\r\n      \"length\": 128920,\r\n      \"name\": \"ps\",\r\n      \"object_references\": 33\r\n    }\r\n  ],\r\n  \"stored_bytes\": 230899,\r\n  \"unique_objects\": 72,\r\n  \"version\": 2\r\n}\r\n"]
[4.54599, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf build --config ./bundle.toml\r\n"]
[5.314226, "o", "\u001b[38;2;255;176;0m$\u001b[0m stat -c \"%n %s bytes\" /usr/bin/ls /usr/bin/ps ./combined\r\n"]
[5.316021, "o", "/usr/bin/ls 153448 bytes\r\n/usr/bin/ps 128920 bytes\r\n./combined 770398 bytes\r\n"]
[6.067672, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf inspect ./combined\r\n"]
[6.069324, "o", "{\r\n  \"default\": \"ls\",\r\n  \"encrypted_objects\": 33,\r\n  \"exec\": \"file\",\r\n  \"launcher_bytes\": 529064,\r\n  \"logical_bytes\": 282368,\r\n  \"lz4_objects\": 33,\r\n  \"manifest_bytes\": 10371,\r\n  \"manifest_position\": \"front\",\r\n  \"payloads\": [\r\n    {\r\n      \"chunk_references\": 39,\r\n      \"hash\": \"205e565539d8ad795cdefc5f9638d7c07391b688bcc0723fa38f43a724e88179\",\r\n      \"length\": 153448,\r\n      \"name\": \"ls\"\r\n    },\r\n    {\r\n      \"chunk_references\": 33,\r\n      \"hash\": \"e4980e5a2daf89d9e7fb11a247ec4edbd81c971dde5f189f8aeaca137e56dc5c\",\r\n      \"length\": 128920,\r\n      \"name\": \"ps\"\r\n    }\r\n  ],\r\n  \"pool_offset\": 539435,\r\n  \"select_env\": \"FATELF_APP\",\r\n"]
[6.069356, "o", "  \"stored_bytes\": 230899,\r\n  \"unique_chunks\": 72,\r\n  \"version\": 2\r\n}\r\n"]
[6.820987, "o", "\r\n\u001b[38;2;0;207;232m# No selector: combined runs ls. Arguments go to the selected program.\u001b[0m\r\n"]
[7.573026, "o", "\u001b[38;2;255;176;0m$\u001b[0m ./combined -1 samples\r\n"]
[7.575687, "o", "alpha.txt\r\nbeta.txt\r\ngamma.txt\r\n"]
[8.327202, "o", "\r\n\u001b[38;2;0;207;232m# Explicit ls selection uses exactly the same executable.\u001b[0m\r\n"]
[9.078922, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ls ./combined -1 samples\r\n"]
[9.081478, "o", "alpha.txt\r\nbeta.txt\r\ngamma.txt\r\n"]
[9.832908, "o", "\r\n\u001b[38;2;0;207;232m# Select ps from that entrypoint; show only PID 1, not the host process list.\u001b[0m\r\n"]
[10.584473, "o", "\r\n\u001b[38;2;0;207;232m# ls needed no key. The encrypted ps variant must reject a missing key.\u001b[0m\r\n"]
[11.336087, "o", "\u001b[38;2;255;176;0m$\u001b[0m if FATELF_APP=ps ./combined -p 1 -o pid,comm; then\r\n  printf \"ERROR: encrypted ps launched without a key\\n\" >&2; exit 1\r\nelse\r\n  printf \"Expected: encrypted ps denied without PS_KEY_FILE\\n\"\r\nfi\r\n"]
[11.337087, "o", "fatelf: preparing payload \"ps\" with File: required key file environment PS_KEY_FILE is missing\r\n"]
[11.33718, "o", "Expected: encrypted ps denied without PS_KEY_FILE\r\n"]
[12.08845, "o", "\u001b[38;2;255;176;0m$\u001b[0m export PS_KEY_FILE=\"$PWD/ps.key\"\r\n"]
[12.839969, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ps ./combined -p 1 -o pid,comm\r\n"]
[12.843639, "o", "    PID COMMAND\r\n      1 systemd\r\n"]
[13.595494, "o", "\r\n\u001b[38;2;0;207;232m# Compare stdout with the native programs and recover both original ELFs.\u001b[0m\r\n"]
[14.347231, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ls ./combined -1 samples > bundled-ls.stdout\r\n/usr/bin/ls -1 samples > native-ls.stdout\r\ncmp bundled-ls.stdout native-ls.stdout\r\n"]
[15.104132, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ps ./combined -p 1 -o pid,comm > bundled-ps.stdout\r\n/usr/bin/ps -p 1 -o pid,comm > native-ps.stdout\r\ncmp bundled-ps.stdout native-ps.stdout\r\n"]
[15.862677, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf extract ./combined --variant ls -o ./recovered-ls\r\n"]
[16.628762, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf extract ./combined --variant ps -o ./recovered-ps\r\n"]
[17.394803, "o", "\u001b[38;2;255;176;0m$\u001b[0m cmp /usr/bin/ls ./recovered-ls && cmp /usr/bin/ps ./recovered-ps\r\n"]
[18.148569, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf verify ./combined\r\n"]
[18.902355, "o", "\r\n\u001b[38;2;0;207;232m# Verified: native stdout matches; both extracted ELFs are byte-exact.\u001b[0m\r\n"]
[19.653596, "o", "\r\nBuild directory: target/ls-ps-file.e4g7Qb\r\n"]
