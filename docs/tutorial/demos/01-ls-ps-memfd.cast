{"version": 2, "width": 110, "height": 34, "timestamp": 1795103037, "idle_time_limit": 3.0, "env": {}, "title": "fatelf: ls + ps (memfd)"}
[0.0161, "o", "\r\n\u001b[38;2;0;207;232m# Two real dynamically linked ELF programs, one executable entrypoint.\u001b[0m\r\n"]
[0.767472, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf --version\r\n"]
[0.779479, "o", "fatelf 0.2.0-beta.1\r\n"]
[1.531136, "o", "\u001b[38;2;255;176;0m$\u001b[0m file /usr/bin/ls /usr/bin/ps\r\n"]
[1.533206, "o", "/usr/bin/ls: ELF 64-bit LSB pie executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, BuildID[sha1]=81b5d6f5a31252fcf5d81891d1cb248635833569, for GNU/Linux 3.2.0, stripped\r\n"]
[1.533507, "o", "/usr/bin/ps: ELF 64-bit LSB pie executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, BuildID[sha1]=fd838af973db29db9e8ca4bed0cda9168a654af6, for GNU/Linux 3.2.0, stripped\r\n"]
[2.285557, "o", "\r\n\u001b[38;2;0;207;232m# Only ps is shuffled; both embedded ELF headers are masked.\u001b[0m\r\n"]
[3.036878, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf pack ls=/usr/bin/ls ps=/usr/bin/ps -o ./combined \\\r\n  --select-env FATELF_APP --default ls --exec memfd \\\r\n  --order shuffled --shuffle-payload ps --seed 42 --dedup \\\r\n  --manifest-position end\r\n"]
[3.795835, "o", "\u001b[38;2;255;176;0m$\u001b[0m stat -c \"%n %s bytes\" /usr/bin/ls /usr/bin/ps ./combined\r\n"]
[3.797116, "o", "/usr/bin/ls 153448 bytes\r\n/usr/bin/ps 128920 bytes\r\n./combined 818832 bytes\r\n"]
[4.548479, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf inspect ./combined\r\n"]
[4.549976, "o", "{\r\n  \"default\": \"ls\",\r\n  \"encrypted_objects\": 0,\r\n  \"exec\": \"memfd\",\r\n  \"launcher_bytes\": 529064,\r\n  \"logical_bytes\": 282368,\r\n  \"lz4_objects\": 0,\r\n  \"manifest_bytes\": 7336,\r\n  \"manifest_position\": \"end\",\r\n  \"payloads\": [\r\n    {\r\n      \"chunk_references\": 39,\r\n      \"hash\": \"205e565539d8ad795cdefc5f9638d7c07391b688bcc0723fa38f43a724e88179\",\r\n      \"length\": 153448,\r\n      \"name\": \"ls\"\r\n    },\r\n    {\r\n      \"chunk_references\": 33,\r\n      \"hash\": \"e4980e5a2daf89d9e7fb11a247ec4edbd81c971dde5f189f8aeaca137e56dc5c\",\r\n      \"length\": 128920,\r\n      \"name\": \"ps\"\r\n"]
[4.549999, "o", "    }\r\n  ],\r\n  \"pool_offset\": 529064,\r\n  \"select_env\": \"FATELF_APP\",\r\n  \"stored_bytes\": 282368,\r\n  \"unique_chunks\": 72,\r\n  \"version\": 2\r\n}\r\n"]
[5.301376, "o", "\r\n\u001b[38;2;0;207;232m# No selector: combined runs ls. Arguments go to the selected program.\u001b[0m\r\n"]
[6.052609, "o", "\u001b[38;2;255;176;0m$\u001b[0m ./combined -1 samples\r\n"]
[6.055085, "o", "alpha.txt\r\nbeta.txt\r\ngamma.txt\r\n"]
[6.806422, "o", "\r\n\u001b[38;2;0;207;232m# Explicit ls selection uses exactly the same executable.\u001b[0m\r\n"]
[7.557897, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ls ./combined -1 samples\r\n"]
[7.56059, "o", "alpha.txt\r\nbeta.txt\r\ngamma.txt\r\n"]
[8.312119, "o", "\r\n\u001b[38;2;0;207;232m# Select ps from that entrypoint; show only PID 1, not the host process list.\u001b[0m\r\n"]
[9.063564, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ps ./combined -p 1 -o pid,comm\r\n"]
[9.067043, "o", "    PID COMMAND\r\n      1 systemd\r\n"]
[9.818814, "o", "\r\n\u001b[38;2;0;207;232m# Compare stdout with the native programs and recover both original ELFs.\u001b[0m\r\n"]
[10.570277, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ls ./combined -1 samples > bundled-ls.stdout\r\n/usr/bin/ls -1 samples > native-ls.stdout\r\ncmp bundled-ls.stdout native-ls.stdout\r\n"]
[11.328115, "o", "\u001b[38;2;255;176;0m$\u001b[0m FATELF_APP=ps ./combined -p 1 -o pid,comm > bundled-ps.stdout\r\n/usr/bin/ps -p 1 -o pid,comm > native-ps.stdout\r\ncmp bundled-ps.stdout native-ps.stdout\r\n"]
[12.085631, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf extract ./combined --variant ls -o ./recovered-ls\r\n"]
[12.852157, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf extract ./combined --variant ps -o ./recovered-ps\r\n"]
[13.618203, "o", "\u001b[38;2;255;176;0m$\u001b[0m cmp /usr/bin/ls ./recovered-ls && cmp /usr/bin/ps ./recovered-ps\r\n"]
[14.372454, "o", "\u001b[38;2;255;176;0m$\u001b[0m fatelf verify ./combined\r\n"]
[15.125904, "o", "\r\n\u001b[38;2;0;207;232m# Verified: native stdout matches; both extracted ELFs are byte-exact.\u001b[0m\r\n"]
[15.877289, "o", "\r\nBuild directory: target/ls-ps-memfd.gHlz7h\r\n"]
